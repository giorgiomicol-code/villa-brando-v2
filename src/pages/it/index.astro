---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactStrip from '../../components/ContactStrip.astro';
import '../../styles/home.css';
import { withBase } from '../../utils/url.ts';
import {
  hero,
  iconStrip,
  discover,
  award,
  families,
  explore,
} from '../../data/home.it.ts';
---

<PageLayout
  title="Villa Brando — Casa Vacanze Esclusiva, Latina"
  description="Villa Brando: casa vacanze esclusiva a Latina, con giardino privato e biciclette. Vicino a Sabaudia, Circeo e Roma."
  canonicalPath="/it/"
  lang="it"
  altHref="/en/"
  ogImage={hero.bgSrc}
>
  <section class="hero">
    <div class="hero-bg">
      <img src={hero.bgSrc} alt={hero.bgAlt} fetchpriority="high" decoding="async" />
    </div>
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="eyebrow">{hero.eyebrow}</div>
        <h1>{hero.title}</h1>
        <div class="subtitle">{hero.subtitle}</div>
        <div class="locations">{hero.locations}</div>
        <div class="hero-actions">
          <a href={hero.ctaPrimary.href} class="btn btn-gold">{hero.ctaPrimary.label}</a>
          <a href={hero.ctaSecondary.href} class="btn btn-outline-light" target="_blank" rel="noopener">{hero.ctaSecondary.label}</a>
        </div>
        <div class="hero-quote">{hero.quote}</div>
      </div>
      <div class="booking-card">
        <h3>{hero.booking.heading}</h3>
        <div class="field-row">
          <div class="field">
            <label for="checkin">{hero.booking.checkin}</label>
            <input type="date" id="checkin" name="checkin" aria-label={hero.booking.checkin} />
          </div>
          <div class="field">
            <label for="checkout">{hero.booking.checkout}</label>
            <input type="date" id="checkout" name="checkout" aria-label={hero.booking.checkout} />
          </div>
        </div>
        <a href={hero.ctaPrimary.href} class="btn btn-search">{hero.booking.cta}</a>
        <div class="note">{hero.booking.note}</div>
        <div class="stay">{hero.booking.stay}</div>
      </div>
    </div>
  </section>

  <div class="icon-strip">
    <div class="wrap icon-row">
      {iconStrip.map((item) => (
        <div class="icon-item">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" aria-hidden="true" set:html={item.markup} />
          <div>
            <h4>{item.title}</h4>
            <span>{item.text}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <section id="villa" class="tinted">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">{discover.eyebrow}</div>
        <h2>{discover.title}</h2>
        <p>{discover.text}</p>
      </div>
      <div class="discover-grid">
        {discover.cards.map((card) => (
          <a href={withBase(card.href)} class="discover-card" id={card.id}>
            <img src={card.imgSrc} alt={card.imgAlt} loading="lazy" />
            <h3>{card.title} <span class="arrow">→</span></h3>
            <div class="sub">{card.sub}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tinted" style="padding-top:0;">
    <div class="wrap">
      <div class="award-banner">
        <div class="award-left">
          <div class="eyebrow">{award.eyebrow}</div>
          <h3>{award.title}</h3>
          <span>{award.detail}</span>
        </div>
        <div class="award-right">
          <p>{award.quote}</p>
          <a href={withBase(award.cta.href)} class="btn btn-outline">{award.cta.label}</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap families-grid">
      <div>
        <div class="eyebrow">{families.eyebrow}</div>
        <h2 class="script-title">{families.title}</h2>
        <p>{families.text}</p>
        <a href={withBase(families.cta.href)} class="btn btn-outline">{families.cta.label}</a>
      </div>
      <div class="media">
        <img src={families.media.imgSrc} alt={families.media.imgAlt} loading="lazy" />
        <div class="tag"><span class="big">{families.media.tagBig}</span>{families.media.tagRest}</div>
      </div>
    </div>
  </section>

  <section class="explore" id="territorio">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">{explore.eyebrow}</div>
        <h2>{explore.title}</h2>
        <p>{explore.text}</p>
      </div>
      <div class="explore-grid">
        {explore.cards.map((card) => (
          <div class="explore-card">
            <img src={card.imgSrc} alt={card.imgAlt} loading="lazy" />
            <h4>{card.title}</h4>
          </div>
        ))}
      </div>
      <div class="explore-actions"><a href={withBase(explore.cta.href)} class="btn btn-outline">{explore.cta.label}</a></div>
    </div>
  </section>

  <ContactStrip lang="it" />
</PageLayout>
