---
import PageLayout from '../../../layouts/PageLayout.astro';
import { rooms } from '../../../data/rooms.it.ts';
---

<PageLayout
  title="Camere — Villa Brando"
  description="Le 4 camere di Villa Brando: Main, Sky, White, Audrey Bedroom. Pagina in costruzione."
  canonicalPath="/it/camere/"
>
  <section class="rooms-intro">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow navy">CAMERE</div>
        <h1>Le Camere di Villa Brando</h1>
        <p>
          4 camere uniche. I contenuti descrittivi di ciascuna camera sono in fase
          di raccolta e verifica dal sito attuale: qui sotto trovi i collegamenti
          alle singole pagine, ancora in costruzione.
        </p>
      </div>
      <div class="rooms-grid">
        {rooms.map((room) => (
          <a href={`/it/camere/${room.slug}/`} class="room-card">
            <h2>{room.name}</h2>
            <span>Contenuto in arrivo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .rooms-intro {
    padding: 96px 0;
  }
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .room-card {
    display: block;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 28px 20px;
    text-align: center;
  }
  .room-card h2 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .room-card span {
    font-size: 0.8rem;
    color: var(--gold);
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .rooms-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
