---
// Pagina 404. Utile soprattutto durante la migrazione degli URL: se un
// indirizzo del vecchio sito non viene intercettato da un redirect, l'ospite
// trova comunque una via di uscita invece di un errore secco.
//
// È bilingue perché è l'unica pagina che non sta né sotto /it/ né sotto /en/:
// non sappiamo in che lingua sia l'ospite che ci arriva, quindi gliele
// mostriamo entrambe invece di indovinare.
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site.ts';
import { withBase } from '../utils/url.ts';

const columns = (['it', 'en'] as const).map((lang) => ({
  lang,
  title: lang === 'it' ? 'Pagina non trovata' : 'Page not found',
  text:
    lang === 'it'
      ? 'La pagina che stai cercando non esiste o è stata spostata.'
      : 'The page you are looking for does not exist or has been moved.',
  homeLabel: lang === 'it' ? 'Vai alla Home' : 'Go to Home',
  destinations: site[lang].nav.filter((item) => item.href !== '#' && item.href !== `/${lang}/`),
}));
---

<PageLayout
  title="Pagina non trovata / Page not found — Villa Brando"
  description="La pagina cercata non esiste o è stata spostata. The page does not exist or has been moved."
  canonicalPath="/404/"
>
  <section class="not-found">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">ERRORE 404</div>
      </div>
      <div class="columns">
        {columns.map((col) => (
          <div class="col" lang={col.lang}>
            <h2>{col.title}</h2>
            <p>{col.text}</p>
            <a href={withBase(`/${col.lang}/`)} class="btn btn-gold">{col.homeLabel}</a>
            <nav class="destinations" aria-label={col.lang === 'it' ? 'Sezioni del sito' : 'Site sections'}>
              {col.destinations.map((item) => (
                <a href={withBase(item.href)}>{item.label}</a>
              ))}
            </nav>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .not-found {
    padding: 100px 0;
  }
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 900px;
    margin: 0 auto;
  }
  .col {
    text-align: center;
  }
  .col h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin-bottom: 12px;
  }
  .col p {
    color: var(--ink-soft);
    margin-bottom: 24px;
  }
  .destinations {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    margin-top: 32px;
  }
  @media (max-width: 700px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .destinations a {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .destinations a:hover {
    color: var(--navy);
  }
</style>
