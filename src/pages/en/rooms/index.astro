---
import PageLayout from '../../../layouts/PageLayout.astro';
import { rooms } from '../../../data/rooms.it.ts';
import { withBase } from '../../../utils/url.ts';
---

<PageLayout
  title="Rooms — Villa Brando"
  description="The 4 bedrooms at Villa Brando: Main, Sky, White, Audrey. Page under construction."
  canonicalPath="/en/rooms/"
  lang="en"
  altHref="/it/camere/"
>
  <section class="rooms-intro">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">ROOMS</div>
        <h1>Our Rooms</h1>
        <p>
          4 unique bedrooms. The descriptive content for each room is still being
          collected and checked against the current site: below are the links to
          the individual pages, still under construction.
        </p>
      </div>
      <div class="rooms-grid">
        {rooms.map((room) => (
          <a href={withBase(`/en/rooms/${room.slug}/`)} class="room-card">
            <h2>{room.name}</h2>
            <span>Coming soon →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .rooms-intro {
    padding: 96px 0;
  }
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .room-card {
    display: block;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 28px 20px;
    text-align: center;
  }
  .room-card h2 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .room-card span {
    font-size: 0.8rem;
    color: var(--gold-text);
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .rooms-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
