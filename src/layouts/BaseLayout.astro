---
import '../styles/global.css';
import { withBase } from '../utils/url.ts';

interface Props {
  title: string;
  description: string;
  lang: 'it' | 'en';
  canonicalPath: string;
  alternates?: { lang: string; path: string }[];
  ogImage?: string;
}

const { title, description, lang, canonicalPath, alternates = [], ogImage } = Astro.props;

// Ambiente di anteprima: le pagine non devono essere indicizzate finché
// non approvate e pubblicate (CLAUDE.md, regola 10). Il dominio base è
// volutamente assente finché non viene scelto e autorizzato un ambiente
// di anteprima pubblico: i link canonical/hreflang restano quindi relativi.
const isPreview = true;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={withBase(canonicalPath)} />
    {/* Favicon provvisoria: sostituire con il logo reale quando disponibile. */}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={withBase(alt.path)} />
    ))}
    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph — solo contenuti già verificati. og:url e un canonical
        assoluto richiedono il dominio finale, non ancora deciso: vedi
        docs/MIGRATION_PLAN.md. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Villa Brando" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
