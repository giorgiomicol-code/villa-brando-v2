---
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a href={href} class="wa-float" aria-label="Scrivi su WhatsApp" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.1L2 22l5.1-1.3A10 10 0 1012 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2z"></path>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 70;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  }
  .wa-float svg {
    width: 28px;
    height: 28px;
    fill: #fff;
  }
</style>
