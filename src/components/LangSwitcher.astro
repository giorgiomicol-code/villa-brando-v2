---
import { withBase } from '../utils/url.ts';
// Selettore lingua sempre visibile e non annidato in altri menu: sul sito
// attuale la lingua era un nodo di primo livello che raddoppiava l'intero
// menu (vedi prompt di progetto).
//
// altHref è la stessa pagina nell'altra lingua. Se manca (pagina che esiste
// solo in una lingua) l'altra lingua resta visibile ma non attivabile,
// invece di mandare l'ospite su un indirizzo inesistente.

interface Props {
  current: 'it' | 'en';
  altHref?: string;
}

const { current, altHref } = Astro.props;
const other = current === 'it' ? 'en' : 'it';
const pending = current === 'it' ? 'Versione inglese non disponibile per questa pagina' : 'Italian version not available for this page';
---

<div class="lang" role="group" aria-label={current === 'it' ? 'Lingua del sito' : 'Site language'}>
  <span class="lang-opt" aria-current="true">{current.toUpperCase()}</span>
  <span class="sep" aria-hidden="true">|</span>
  {altHref ? (
    <a href={withBase(altHref)} class="lang-opt" hreflang={other} lang={other}>{other.toUpperCase()}</a>
  ) : (
    <span class="lang-opt unavailable" aria-disabled="true" title={pending}>{other.toUpperCase()}</span>
  )}
</div>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .lang-opt {
    color: var(--ink-soft);
    padding: 2px 2px;
  }
  .lang-opt[aria-current='true'] {
    color: var(--navy);
    border-bottom: 2px solid var(--gold);
  }
  .lang-opt.unavailable {
    color: var(--ink-soft);
    opacity: 0.45;
    cursor: not-allowed;
  }
  .sep {
    color: var(--line);
  }
</style>
