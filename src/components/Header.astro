---
import { site, type Lang } from '../data/site.ts';
import LangSwitcher from './LangSwitcher.astro';
import { withBase } from '../utils/url.ts';

interface Props {
  lang: Lang;
  altHref?: string;
}

const { lang, altHref } = Astro.props;
const { nav, brand, bookingHref } = site[lang];
const bookLabel = lang === 'it' ? 'Prenota' : site.en.bookLabel;
const home = `/${lang}/`;
const labels =
  lang === 'it'
    ? { nav: 'Navigazione principale', open: 'Apri menu', close: 'Chiudi menu' }
    : { nav: 'Main navigation', open: 'Open menu', close: 'Close menu' };
const currentPath = Astro.url.pathname;
---

<header>
  <div class="nav-row">
    <a href={withBase(home)} class="brand">
      <img src={brand.logoSrc} alt={`Logo ${brand.name}`} width="38" height="38" />
      <span class="word">{brand.name}<small>{brand.tagline}</small></span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label={labels.nav}>
      {nav.map((item) => {
        const isActive =
          item.href !== '#' && (item.href === home ? currentPath === home : currentPath.startsWith(item.href));
        return (
          <a href={withBase(item.href)} class={isActive ? 'active' : undefined} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>
    <div class="nav-actions">
      <LangSwitcher current={lang} altHref={altHref} />
      <a href={bookingHref} class="btn btn-gold">{bookLabel}</a>
      <button
        class="hamburger"
        id="nav-toggle"
        aria-label={labels.open}
        data-label-open={labels.open}
        data-label-close={labels.close}
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('main-nav');
  const labelOpen = toggle?.dataset.labelOpen ?? 'Apri menu';
  const labelClose = toggle?.dataset.labelClose ?? 'Chiudi menu';
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    toggle.setAttribute('aria-label', isOpen ? labelClose : labelOpen);
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', labelOpen);
    });
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav-row {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }
  .brand .word {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    color: var(--navy);
    line-height: 1.1;
  }
  .brand .word small {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    font-weight: 600;
  }
  nav.main-nav {
    display: flex;
    gap: 28px;
  }
  nav.main-nav a {
    font-size: 0.9rem;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  nav.main-nav a.active {
    color: var(--navy);
    font-weight: 600;
    border-bottom: 2px solid var(--gold);
    padding-bottom: 4px;
  }
  nav.main-nav a:hover {
    color: var(--navy);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--navy);
    margin: 5px 0;
  }
  @media (max-width: 980px) {
    nav.main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
      flex-direction: column;
      gap: 0;
      padding: 8px 32px 16px;
    }
    nav.main-nav.open {
      display: flex;
    }
    nav.main-nav a {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }
    nav.main-nav a.active {
      border-bottom: 1px solid var(--line);
    }
    .hamburger {
      display: block;
    }
  }
</style>
