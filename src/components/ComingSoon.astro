---
// Pagina segnaposto per una sezione della IA approvata il cui contenuto reale
// (testo del sito attuale) non è ancora stato fornito/verificato. Per regola
// di progetto non si inventa testo generico: si dichiara esplicitamente lo
// stato "contenuto in arrivo". Vedi docs/MIGRATION_PLAN.md.
import { site, type Lang } from '../data/site.ts';

interface Props {
  eyebrow: string;
  title: string;
  note?: string;
  anchorId?: string;
  lang?: Lang;
}

const { eyebrow, title, note, anchorId, lang = 'it' } = Astro.props;
const { whatsappHref } = site[lang];
const copy =
  lang === 'it'
    ? {
        body: 'Questa pagina è in fase di costruzione: i contenuti reali di questa sezione del sito attuale sono in corso di raccolta e verifica, per non sostituirli con testo generico o inventato.',
        home: 'Torna alla Home',
        whatsapp: 'Scrivi su WhatsApp',
      }
    : {
        body: 'This page is being built: the real content for this section is still being collected and checked, so that it is not replaced with generic or invented text.',
        home: 'Back to Home',
        whatsapp: 'Message us on WhatsApp',
      };
---

<section class="coming-soon" id={anchorId}>
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{title}</h1>
      <p>{copy.body}</p>
      {note && <p class="note">{note}</p>}
      <div class="actions">
        <a href={`/${lang}/`} class="btn btn-outline">{copy.home}</a>
        <a href={whatsappHref} class="btn btn-gold" target="_blank" rel="noopener">{copy.whatsapp}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .coming-soon {
    padding: 120px 0;
  }
  .coming-soon h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 10px 0 16px;
  }
  .coming-soon .note {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .coming-soon .actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 24px;
  }
</style>
