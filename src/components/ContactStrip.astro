---
import { contactStrip } from '../data/site.it.ts';

const icons: Record<string, string> = {
  Chiama:
    'M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.4 2.1L8 9.9a16 16 0 006 6l1.4-1.3a2 2 0 012.1-.4c.9.3 1.8.5 2.7.6a2 2 0 011.7 2z',
  WhatsApp:
    'M21 11.5a8.4 8.4 0 01-8.4 8.4 8.6 8.6 0 01-4-.9L3 20l1.1-5.4A8.4 8.4 0 1121 11.5z',
};
---

<div class="contact-strip" id="contatti">
  <div class="wrap contact-row">
    {contactStrip.map((item) => (
      <a href={item.href} class="item">
        {item.label === 'Email' ? (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
        ) : item.label === 'Indicazioni' ? (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" aria-hidden="true">
            <path d="M12 21s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12z"></path>
            <circle cx="12" cy="9" r="2.4"></circle>
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" aria-hidden="true">
            <path d={icons[item.label]}></path>
          </svg>
        )}
        {item.label}
      </a>
    ))}
  </div>
</div>

<style>
  .contact-strip {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding: 34px 0;
  }
  .contact-row {
    display: flex;
    justify-content: center;
    gap: 56px;
    flex-wrap: wrap;
  }
  .contact-row .item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--navy);
    font-weight: 500;
  }
  .contact-row svg {
    width: 18px;
    height: 18px;
    stroke: var(--gold);
  }
</style>
