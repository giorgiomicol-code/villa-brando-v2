---
import { site, type Lang } from '../data/site.ts';
import { withBase } from '../utils/url.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { contactStrip } = site[lang];

// Icone per chiave stabile, non per etichetta: le etichette cambiano con la
// lingua ("Chiama" / "Call Us"), la chiave no.
const icons: Record<string, string> = {
  phone:
    '<path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.4 2.1L8 9.9a16 16 0 006 6l1.4-1.3a2 2 0 012.1-.4c.9.3 1.8.5 2.7.6a2 2 0 011.7 2z"/>',
  whatsapp:
    '<path d="M21 11.5a8.4 8.4 0 01-8.4 8.4 8.6 8.6 0 01-4-.9L3 20l1.1-5.4A8.4 8.4 0 1121 11.5z"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  directions: '<path d="M12 21s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/>',
};
---

<div class="contact-strip" id="contatti">
  <div class="wrap contact-row">
    {contactStrip.map((item) => (
      <a href={withBase(item.href)} class="item">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" aria-hidden="true" set:html={icons[item.icon]} />
        {item.label}
      </a>
    ))}
  </div>
</div>

<style>
  .contact-strip {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding: 34px 0;
  }
  .contact-row {
    display: flex;
    justify-content: center;
    gap: 56px;
    flex-wrap: wrap;
  }
  .contact-row .item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--navy);
    font-weight: 500;
  }
  .contact-row svg {
    width: 18px;
    height: 18px;
    stroke: var(--gold);
  }
</style>
