---
import { siteConfig } from '../config/site';
---

<div class="contact-actions">
  <a class="contact-button" href={siteConfig.phoneHref}>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M7.2 3.4 10 8.3 7.9 10a15 15 0 0 0 6.1 6.1l1.7-2.1 4.9 2.8-.8 3.3c-.2.8-.9 1.4-1.8 1.4C9.5 21.5 2.5 14.5 2.5 6c0-.9.6-1.6 1.4-1.8l3.3-.8Z" />
    </svg>
    <span>
      <small data-lang="en">Call Giorgio</small>
      <small data-lang="it" hidden>Chiama Giorgio</small>
      {siteConfig.phoneDisplay}
    </span>
  </a>

  <a
    class="contact-button whatsapp"
    href={siteConfig.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.1Z" />
      <path d="M8.5 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.8 1.9c.1.3.1.5-.1.7l-.7.9c-.2.2-.1.4 0 .6.8 1.4 1.8 2.4 3.3 3.1.3.1.5.1.7-.1l.9-1.1c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.5 0 .3-.2 1.4-1 2-.7.7-1.7.9-2.4.7-1.1-.2-2.6-.7-4.5-2.3-1.5-1.3-2.6-2.9-3-4-.4-1-.1-2.6.7-3.6Z" />
    </svg>
    <span>
      <small data-lang="en">Message on</small>
      <small data-lang="it" hidden>Scrivi su</small>
      WhatsApp
    </span>
  </a>
</div>
